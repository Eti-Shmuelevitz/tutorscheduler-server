<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      internalLogFile="internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <targets>
    <target xsi:type="File" name="allfile" fileName="logs/tutorscheduler-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|correlationId=${scopeproperty:CorrelationId}|${message}${onexception:|${exception:format=tostring}}" />

    <target xsi:type="Console" name="console"
            layout="${longdate}|${level:uppercase=true}|correlationId=${scopeproperty:CorrelationId}|${message}" />
  </targets>

  <rules>
    <!-- EF Core logs every failed SaveChanges at Error - including the
         concurrency conflicts our Services catch and answer with 409. Those
         are already logged once, at Warning, by the Service. A genuinely
         unhandled database failure is still logged at Error, with the full
         exception, by ExceptionHandlingMiddleware. -->
    <logger name="Microsoft.EntityFrameworkCore.Update" maxlevel="Error" final="true" />
    <logger name="Microsoft.EntityFrameworkCore.Database.Command" maxlevel="Error" final="true" />
    <!-- Silence framework noise below Warning; our own code's Debug/Info still gets through. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Debug" writeTo="allfile,console" />
  </rules>
</nlog>
